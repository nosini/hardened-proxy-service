#!/usr/bin/python3 -I
"""Select mihomo's process-lookup sandbox from its existing YAML settings."""

from pathlib import Path
import os
import posixpath
import re
import sys


CONFIG = Path("/etc/mihomo/config.yaml")
MAP = "/run/mihomo-bpf/conn_owners"
START = "ExecStart=\nExecStart=/usr/local/bin/mihomo -d /etc/mihomo\n"
# Restart=no keeps a blocked startup from restarting the failing placeholder forever.
DENY = "[Service]\nExecStart=\nExecStart=/usr/bin/false\nRestart=no\n"
BOOLEAN_DIR = Path("/sys/fs/selinux/booleans")
# The optional Wine observer is started with mihomo when it's installed. Its unit
# no longer enables itself, so it doesn't start with mihomo when lookup is off.
# systemd searches these in order; the first entry decides, as for systemctl.
OBSERVER_PATHS = (
    Path("/etc/systemd/system/socketowner-wine-observer.service"),
    Path("/run/systemd/system/socketowner-wine-observer.service"),
    Path("/usr/local/lib/systemd/system/socketowner-wine-observer.service"),
    Path("/usr/lib/systemd/system/socketowner-wine-observer.service"),
)
GROUP_FILE = Path("/etc/group")


NULL = "tag:yaml.org,2002:null"
BOOL = "tag:yaml.org,2002:bool"
STR = "tag:yaml.org,2002:str"
INT = "tag:yaml.org,2002:int"
MERGE = "tag:yaml.org,2002:merge"
DEFAULT_MAP = "/sys/fs/bpf/mihomo/maps/conn_owners"
BOOLEANS = {
    **dict.fromkeys(("true", "True", "TRUE"), True),
    **dict.fromkeys(("false", "False", "FALSE"), False),
}
# yaml.v3 still accepts YAML 1.1 spellings, plain or quoted, for typed booleans.
LEGACY_BOOLEANS = {
    **dict.fromkeys(("y", "Y", "yes", "Yes", "YES", "on", "On", "ON"), True),
    **dict.fromkeys(("n", "N", "no", "No", "NO", "off", "Off", "OFF"), False),
}


def compose(filename):
    # Import here so a missing PyYAML also leaves a drop-in that prevents startup.
    import yaml

    class Loader(yaml.SafeLoader):
        def compose_node(self, parent, index):
            # yaml.v3 lets a later anchor replace an earlier one of the same name.
            if not self.check_event(yaml.AliasEvent):
                self.anchors.pop(self.peek_event().anchor, None)
            return super().compose_node(parent, index)

    # Mihomo uses YAML 1.2 resolution, where find-process-mode: off is a string.
    # Only true and false resolve to booleans.
    Loader.yaml_implicit_resolvers = {
        key: [(tag, regex) for tag, regex in values if tag != BOOL]
        for key, values in Loader.yaml_implicit_resolvers.items()
    }
    Loader.add_implicit_resolver(
        BOOL, re.compile(r"^(?:true|True|TRUE|false|False|FALSE)$"), list("tTfF"))
    # Like yaml.v3, use the first document.
    with filename.open() as stream:
        return next(yaml.compose_all(stream, Loader=Loader), None), yaml


def fields(mapping, yaml):
    """Find one mapping's values the way yaml.v3 decodes mihomo's configuration.

    Works on the composed nodes, which PyYAML's merge flattening would modify:
    each mapping's own keys must be unique, explicit keys win over merged ones,
    and earlier merge sources win over later ones.
    """
    found = {}
    active = set()
    done = set()

    def visit(node):
        if not isinstance(node, yaml.MappingNode):
            raise ValueError("configuration and merge sources must be mappings")
        if id(node) in active:
            raise ValueError("recursive YAML merge")
        if id(node) in done:
            return
        active.add(id(node))
        keys = set()
        merge = None
        for key, value in node.value:
            if not isinstance(key, yaml.ScalarNode):
                continue
            # Like yaml.v3, compare the keys as written, including <<.
            if key.value in keys:
                raise ValueError("duplicate YAML key")
            keys.add(key.value)
            if key.tag == MERGE:
                merge = value
            else:
                found.setdefault(key.value, value)
        if merge is not None:
            for source in merge.value if isinstance(merge, yaml.SequenceNode) else [merge]:
                visit(source)
        active.remove(id(node))
        done.add(id(node))

    visit(mapping)
    return found


def scalar(found, name, yaml):
    # Null leaves mihomo's default in place.
    node = found.get(name)
    if node is None or node.tag == NULL:
        return None
    if not isinstance(node, yaml.ScalarNode):
        raise ValueError(f"{name} must be a scalar")
    return node


def value(found, name, yaml):
    """A scalar value the sandbox doesn't depend on, or None if unset or not a scalar."""
    node = found.get(name)
    if node is None or node.tag == NULL or not isinstance(node, yaml.ScalarNode):
        return None
    return node


def port(node):
    """A port setting, decoded like yaml.v3 decodes an integer field."""
    if node is None or node.tag != INT:
        return None
    try:
        return int(node.value, 10)
    except ValueError:
        return None


def boolean(found, name, yaml):
    """A boolean setting mihomo reads; anything else leaves it false."""
    node = value(found, name, yaml)
    if node is not None and node.tag == BOOL:
        return BOOLEANS.get(node.value, False)
    if node is not None and node.tag == STR:
        return LEGACY_BOOLEANS.get(node.value, False)
    return False


def listen_port(node):
    """The port of a listen address such as 127.0.0.1:53 or [::]:53."""
    if node is None or node.tag != STR:
        return None
    address = node.value.strip()
    if address.startswith("["):
        _, bracket, rest = address.partition("]")
        if not bracket or not rest.startswith(":"):
            return None
        number = rest[1:]
    else:
        _, colon, number = address.rpartition(":")
        if not colon:
            return None
    if not number.isdigit():
        return None
    return int(number)


def settings(filename):
    """Read the lookup sandbox and the listener settings the unit needs."""
    root, yaml = compose(filename)
    if root is None:
        raise ValueError("configuration must be a mapping")
    found = fields(root, yaml)

    # find-process-mode is decoded as text, whatever the scalar resolves to.
    node = scalar(found, "find-process-mode", yaml)
    process_mode = "strict" if node is None else node.value.lower()
    if process_mode not in ("off", "strict", "always"):
        raise ValueError("invalid find-process-mode")

    node = scalar(found, "find-process-bpf-only", yaml)
    if node is None:
        # Mihomo permits the /proc fallback, but the default sandbox doesn't grant it.
        only = None
    elif node.tag == BOOL and node.value in BOOLEANS:
        only = BOOLEANS[node.value]
    elif node.tag == STR and node.value in LEGACY_BOOLEANS:
        only = LEGACY_BOOLEANS[node.value]
    else:
        raise ValueError("find-process-bpf-only must be a boolean")

    node = scalar(found, "find-process-bpf-map", yaml)
    bpf_map = DEFAULT_MAP if node is None else node.value
    # A redundant separator still names the map the service binds; an empty
    # value stays empty rather than becoming ".".
    bpf_map = posixpath.normpath(bpf_map) if bpf_map else ""

    # Only an explicit false selects the /proc fallback. An absent key uses the
    # BPF-only sandbox, so process lookup never gets /proc access by default.
    if process_mode == "off":
        mode = "off"
    elif only is False:
        mode = "proc"
    elif bpf_map == MAP:
        mode = "bpf"
    elif only is None:
        # Neither the fallback nor this service's map was asked for, as in an
        # upstream configuration: run without lookup privileges, so lookups fail.
        mode = "off"
    else:
        raise ValueError("BPF-only lookup requires the service's map path")

    dns = found.get("dns")
    dns_found = fields(dns, yaml) if isinstance(dns, yaml.MappingNode) else {}
    listeners = [
        port(value(found, "mixed-port", yaml)),
        port(value(found, "port", yaml)),
        port(value(found, "socks-port", yaml)),
        port(value(found, "redir-port", yaml)),
        port(value(found, "tproxy-port", yaml)),
        listen_port(value(found, "external-controller", yaml)),
        listen_port(value(dns_found, "listen", yaml)),
    ]
    # Binding a port below 1024 needs CAP_NET_BIND_SERVICE. Port 0 asks for any free
    # port, so it doesn't.
    bind_service = any(p is not None and 0 < p < 1024 for p in listeners)
    tproxy = port(value(found, "tproxy-port", yaml)) or 0
    iptables = found.get("iptables")
    iptables_found = fields(iptables, yaml) if isinstance(iptables, yaml.MappingNode) else {}
    tun = found.get("tun")
    tun_found = fields(tun, yaml) if isinstance(tun, yaml.MappingNode) else {}
    # Mihomo runs its own iptables setup only outside TUN, for a TPROXY port.
    use_iptables = (
        tproxy > 0
        and boolean(iptables_found, "enable", yaml)
        and not boolean(tun_found, "enable", yaml)
    )
    return {"mode": mode, "bind_service": bind_service, "tproxy": tproxy,
            "iptables": use_iptables, "bpf_map": bpf_map}


def lookup_mode(filename):
    return settings(filename)["mode"]


def grants(bind_service, proc=False):
    """Capability lines for what the selected mode needs beyond the base unit."""
    caps = "CAP_NET_ADMIN"
    if bind_service:
        caps += " CAP_NET_BIND_SERVICE"
    if proc:
        caps += " CAP_SYS_PTRACE CAP_DAC_READ_SEARCH"
    if caps == "CAP_NET_ADMIN":
        # The base unit already grants CAP_NET_ADMIN, ambient included.
        return ""
    return (
        "CapabilityBoundingSet=\n"
        f"CapabilityBoundingSet={caps}\n"
        "AmbientCapabilities=\n"
        f"AmbientCapabilities={caps}\n"
    )


def observer_installed():
    """Whether an unmasked Wine observer unit wins systemd's search order."""
    for path in OBSERVER_PATHS:
        if not os.path.lexists(path):
            continue
        if path.is_symlink() and os.path.realpath(path) == "/dev/null":
            return False
        try:
            if not path.read_text():
                return False
        except OSError:
            # A dangling symlink is still the winning entry, not a missing unit.
            pass
        return True
    return False


def observer_unit():
    """Unit lines for the optional Wine observer, which the generator starts."""
    if not observer_installed():
        return ""
    return (
        "Wants=socketowner-wine-observer.service\n"
        "After=socketowner-wine-observer.service\n"
    )


def dropin(mode, bind_service=False, iptables=False, bpf_map=DEFAULT_MAP):
    # Mihomo's TPROXY iptables setup, which the base unit's exec restriction
    # forbids; SELinux still requires mihomo_use_iptables for it.
    exec_paths = "NoExecPaths=\n" if iptables else ""
    return _dropin(mode, bind_service, bpf_map=bpf_map) + exec_paths


def _dropin(mode, bind_service, bpf_map=DEFAULT_MAP):
    if mode == "bpf":
        return (
            "[Unit]\nRequires=socketowner.service\nAfter=socketowner.service\n" +
            observer_unit() +
            "\n[Service]\n" + START +
            # bpf is only needed to read socketowner's maps; the base unit denies it.
            "SystemCallFilter=bpf\n" +
            "BindReadOnlyPaths=/sys/fs/bpf/mihomo/maps:/run/mihomo-bpf\n" +
            grants(bind_service)
        )
    if mode == "proc":
        if bpf_map == MAP:
            return (
                # Start the loader when it's installed, but run without it if it fails.
                "[Unit]\nWants=socketowner.service\n" +
                observer_unit() +
                "\n[Service]\n" + START +
                # Optional socket-owner acceleration uses bpf too.
                "SystemCallFilter=bpf\n" +
                "ProtectProc=default\n" +
                grants(bind_service, proc=True) +
                # Optional socket-owner acceleration, including without -exec-paths.
                "BindReadOnlyPaths=-/sys/fs/bpf/mihomo/maps:/run/mihomo-bpf\n"
            )
        # Without the service's map path mihomo can't find the maps, so don't
        # start the loader or grant bpf() and its mount.
        return (
            "[Service]\n" + START +
            "ProtectProc=default\n" +
            grants(bind_service, proc=True)
        )
    if mode == "off":
        return "[Service]\n" + START + grants(bind_service)
    raise ValueError("invalid lookup mode")


def boolean_off(name):
    """Whether SELinux is active and the boolean exists and is off."""
    try:
        # selinuxfs writes "<active> <pending>", so only the first field counts.
        return (BOOLEAN_DIR / name).read_text().split()[:1] == ["0"]
    except OSError:
        return False


def warn(configuration):
    """Point at SELinux booleans the selected settings need."""
    if configuration["mode"] == "proc" and configuration["bpf_map"] not in ("", MAP):
        print("mihomo-process-generator: /proc process lookup exposes socketowner's "
              f"maps only at {MAP}, so BPF lookup, FLATPAK-APP, SYSTEMD-UNIT and "
              f"WINE-PROCESS-* rules need 'find-process-bpf-map: {MAP}'",
              file=sys.stderr)
    if configuration["mode"] == "proc" and boolean_off("mihomo_find_process_proc"):
        print("mihomo-process-generator: /proc process lookup needs the SELinux "
              "boolean mihomo_find_process_proc; run "
              "'setsebool -P mihomo_find_process_proc on'", file=sys.stderr)
    if configuration["iptables"] and boolean_off("mihomo_use_iptables"):
        print("mihomo-process-generator: TPROXY needs the SELinux boolean "
              "mihomo_use_iptables; run "
              "'setsebool -P mihomo_use_iptables on'", file=sys.stderr)


def generate(output, config=CONFIG):
    directory = output / "mihomo.service.d"
    directory.mkdir(parents=True, exist_ok=True)
    target = directory / "50-process-lookup.conf"
    target.write_text(DENY)
    # The observer may start independently, so it needs its GID even when the
    # configuration can't be read and mihomo stays blocked.
    reader_group(output)
    try:
        configuration = settings(config)
        contents = dropin(configuration["mode"], configuration["bind_service"],
                          iptables=configuration["iptables"],
                          bpf_map=configuration["bpf_map"])
    except Exception:
        # YAML errors can include credentials from the offending line. Log no
        # configuration contents, and do not grant access on a parsing failure.
        print("mihomo-process-generator: cannot read lookup settings from "
              "/etc/mihomo/config.yaml; check YAML, lookup settings and PyYAML; "
              "mihomo startup is blocked", file=sys.stderr)
        return 1
    target.write_text(contents)
    warn(configuration)
    return 0


def reader_group(output, group="mihomo"):
    """Give the Wine observer the reader group's GID, so its sandbox needs no /etc."""
    if not observer_installed():
        return
    # Read /etc/group itself: an NSS lookup can ask systemd, which is waiting for this
    # generator during daemon-reload, and deadlock. systemd-sysusers puts the group there.
    gid = None
    try:
        for line in GROUP_FILE.read_text().splitlines():
            fields = line.split(":")
            if len(fields) >= 3 and fields[0] == group and fields[2].isdigit():
                gid = int(fields[2])
                break
    except OSError:
        pass
    if gid is None:
        # The unit's default, the group name, then fails visibly in the observer.
        return
    directory = output / "socketowner-wine-observer.service.d"
    directory.mkdir(parents=True, exist_ok=True)
    (directory / "50-reader-group.conf").write_text(
        f"[Service]\nEnvironment=READER_GROUP={gid}\n")


if __name__ == "__main__":
    if len(sys.argv) not in (2, 4):
        sys.exit("usage: mihomo-process-generator NORMAL-DIR [EARLY-DIR LATE-DIR]")
    sys.exit(generate(Path(sys.argv[1])))
