[Unit]
Description=Record the process behind each connection for mihomo
# mihomo binds the maps directory into its sandbox when it starts, so attach first. In
# BPF-only mode mihomo.service has Requires=socketowner.service, so restarting this unit
# restarts mihomo.service too; in /proc mode mihomo picks up the new maps without
# restarting. The directory stays when this stops or restarts.
Before=mihomo.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/socketowner -reader-group mihomo -exec-paths attach
ExecStop=/usr/local/bin/socketowner detach

# Loading and attaching cgroup BPF programs takes CAP_BPF and CAP_NET_ADMIN; CAP_CHOWN
# gives the maps to the mihomo group. -exec-paths also records each process's executable,
# so that mihomo needn't read other processes' /proc entries, and the process that sends
# on a connected socket. Those programs are LSM programs that read kernel structures,
# which takes CAP_PERFMON and lets them read kernel memory. They are fixed and checked by
# the kernel's verifier, and the loader exits once they are attached. Without
# -exec-paths, drop CAP_PERFMON and see "Process lookup" in README.md.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_CHOWN
NoNewPrivileges=yes
SystemCallFilter=@system-service bpf
# process_vm_readv, process_vm_writev and kcmp reach into another process's memory or
# kernel state. The loader needs none of them; the observer, which runs with
# CAP_SYS_PTRACE, denies them too.
SystemCallFilter=~process_vm_readv process_vm_writev kcmp
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# The loader runs as root to pin in /sys/fs/bpf, whose root directory is root's alone.
# ProtectKernelTunables= would make /sys/fs/bpf read-only too, and ReadWritePaths= can't
# undo that, so its paths are spelled out here with bpffs as the exception: /sys and the
# /proc entries it makes read-only, and the two it hides. Entries whose path a kernel may
# lack are marked with -. Attaching only opens /sys/fs/cgroup.
ProtectSystem=strict
ReadOnlyPaths=/sys /proc/sys /proc/sysrq-trigger /proc/fs /proc/irq
ReadOnlyPaths=-/proc/acpi -/proc/apm -/proc/asound -/proc/bus -/proc/latency_stats
ReadOnlyPaths=-/proc/mtrr -/proc/scsi -/proc/timer_stats
InaccessiblePaths=-/proc/kallsyms -/proc/kcore
ReadWritePaths=/sys/fs/bpf
ProtectControlGroups=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077

# No [Install] section: mihomo-process-generator makes mihomo start this in
# BPF-only mode, and in /proc mode only when find-process-bpf-map is the
# service's /run/mihomo-bpf/conn_owners. In BPF-only mode mihomo requires it; in
# /proc mode mihomo starts without it if attaching fails.
