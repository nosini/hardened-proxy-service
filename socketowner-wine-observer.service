[Unit]
Description=Attribute Wine connections to Windows programs for mihomo
Requires=socketowner.service
PartOf=socketowner.service
After=socketowner.service
Before=mihomo.service
# RestartSec=6 never reaches the default limit of 5 starts in 10 s, so without this a
# permanent error would restart the observer forever.
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
# mihomo-process-generator replaces the group name with its numeric GID in a drop-in, so
# the observer needs no /etc to look it up.
Environment=READER_GROUP=mihomo
ExecStart=/usr/local/bin/socketowner-wine-observer -pin /sys/fs/bpf/mihomo/maps -reader-group ${READER_GROUP}
Restart=on-failure
# A killed observer leaves pins; wait past the five-second heartbeat expiry.
RestartSec=6
TimeoutStartSec=30
# Each Wine socket logs a few JSON lines. Bound bursts from a game opening many,
# below journald's default of 10000 per 30 seconds.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=2000
# CAP_SYS_PTRACE and CAP_DAC_READ_SEARCH let it follow other users' process links to find
# each sandbox's pasta. The others load and attach the capture programs and give the
# published maps to the reader group.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_CHOWN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
SystemCallFilter=@system-service bpf
# These reach into another process's memory or kernel state; the observer has no use for
# them even though it holds CAP_SYS_PTRACE. SystemCallErrorNumber= makes them fail with
# EPERM rather than kill the process.
SystemCallFilter=~process_vm_readv process_vm_writev kcmp
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# The observer runs as root for as long as the system is up, holding CAP_SYS_PTRACE and
# CAP_DAC_READ_SEARCH over other processes, so it gets an empty read-only root and only
# the paths below. ProtectSystem=strict would leave the host's filesystem visible.
TemporaryFileSystem=/:ro
# Binding the executable on its own would have systemd create a file mount point, which
# SELinux refuses, so its directory is bound. /etc isn't: the reader group arrives as a
# numeric GID, and the host's secrets (shadow, mihomo's config) stay out of view, which
# matters for a root process with CAP_DAC_READ_SEARCH.
BindReadOnlyPaths=/usr/local/bin
# READY=1 goes to systemd's socket, which a temporary root would hide like any other path.
BindReadOnlyPaths=/run/systemd/notify
# The wineserver and pasta of each sandbox, through their ns, exe and fd links,
# and each pasta's DNS translation, through its command line. ProtectProc stays
# at its default: hiding other processes would hide those lookups.
BindReadOnlyPaths=/proc
# The cgroup whose egress hook it attaches, the kernel BTF its programs are relocated
# against, and the LSM list it checks before attaching them.
BindReadOnlyPaths=/sys/fs/cgroup /sys/kernel/btf /sys/kernel/security
# Its Wine maps are pinned next to socketowner's; bpffs is the only writable path.
BindPaths=/sys/fs/bpf
# ProtectKernelTunables= would make /sys/fs/bpf read-only too, so it stays off. The
# temporary root already makes everything else on its list read-only, but the two files
# it hides are readable through the /proc bind, so they are hidden here.
InaccessiblePaths=-/proc/kallsyms -/proc/kcore
# /dev/null for standard input, and none of the host's other devices.
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET
# The only socket it makes reads the host's namespace cookie with
# getsockopt(SO_NETNS_COOKIE) and is never bound or connected, so no network is needed.
# PrivateNetwork= would hide the host namespace, so it stays off.
IPAddressDeny=any
SocketBindDeny=any
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077

# No [Install] section: mihomo-process-generator starts the observer with mihomo whenever
# process lookup is on, since it only matters to readers that are looking processes up.
