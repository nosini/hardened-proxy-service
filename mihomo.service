[Unit]
Description=mihomo
After=network-online.target killswitch.service socketowner.service
Wants=network-online.target
Requires=killswitch.service

[Service]
Type=simple
User=mihomo
Group=mihomo
# The generator selects the sandbox and replaces this command. If it is missing or
# can't read config.yaml, fail rather than start with mismatched lookup permissions.
ExecStart=/usr/bin/false
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
# Generous bounds against a runaway process, not a working-set target: mihomo
# needs one thread per active connection and buffers traffic in memory.
TasksMax=16384
MemoryMax=4G

# CAP_NET_RAW dropped (no AF_PACKET / raw-socket use). Restore on both lines
# if transparent proxy or raw sockets break.
# The generator adds CAP_NET_BIND_SERVICE only when a listener port is below 1024, and
# the process-inspection capabilities only for /proc lookup.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes

SystemCallFilter=@system-service
# @system-service includes @ipc (process_vm_readv/writev), @keyring, @memlock,
# @setuid and @chown. Mihomo and the Go runtime need none of them: no keyrings,
# no mlock, credentials come from systemd, and the files mihomo writes (cache.db,
# ruleset) are already owned by its user. Denying the process_vm calls matters in
# /proc mode, where CAP_SYS_PTRACE and the host PID namespace would otherwise let a
# compromised mihomo read or write other processes' memory. kcmp compares other
# processes' file descriptors, which process lookup does not need.
# EPERM makes a denied call fail softly instead of killing the process.
SystemCallFilter=~process_vm_readv process_vm_writev kcmp @keyring @memlock @setuid @chown
SystemCallFilter=~open_by_handle_at name_to_handle_at kexec_load kexec_file_load swapon swapoff
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

TemporaryFileSystem=/:ro
# Config dir is read-only; only the paths mihomo actually updates are writable.
# /proc is read-only too, with other users' processes hidden unless lookup needs them.
# cache.db MUST be writable: profile.store-fake-ip/store-selected open it O_RDWR, and a
# read-only mount breaks the fake-ip store (apps then leak to real IPs).
# ruleset/ and cache.db must exist before start (mihomo.tmpfiles creates them), because
# mihomo can't create files in the read-only /etc/mihomo. geoip.metadb is only needed for
# GEOIP rules and has to be downloaded beforehand for the same reason.
# Trust stores: the CA bundles in /etc/ssl are symlinks into /usr/share (Debian),
# /var/lib/ca-certificates (openSUSE), /etc/pki (Fedora) or /etc/ca-certificates (Arch).
# /etc/resolv.conf and /etc/hosts stay hidden: a file mount point under /etc in the empty
# root would be labeled root_t, and SELinux doesn't let init_t create those (directories
# are fine). Binding all of /etc would expose too much. So the "system" nameserver and
# dns.use-system-hosts don't work; configure DNS explicitly.
BindReadOnlyPaths=/usr /etc/mihomo
BindReadOnlyPaths=-/etc/ssl -/etc/pki -/etc/ca-certificates -/var/lib/ca-certificates
BindPaths=/dev/null /dev/net/tun /etc/mihomo/ruleset /etc/mihomo/cache.db
BindPaths=-/etc/mihomo/geoip.metadb
# Nothing may be executed from the read-only root except mihomo itself and the
# ExecStart=/usr/bin/false that the generator replaces. /usr stays readable: mihomo reads
# CA bundles and zoneinfo from it. /usr/bin/false also needs its dynamic loader and libc;
# allow both the /lib64 and the usr-merged /usr/lib64 path, and ignore whichever is absent.
NoExecPaths=/
ExecPaths=/usr/local/bin/mihomo /usr/bin/false
ExecPaths=-/lib64/ld-linux-x86-64.so.2 -/usr/lib64/ld-linux-x86-64.so.2
ExecPaths=-/lib64/libc.so.6 -/usr/lib64/libc.so.6
# The generator binds the BPF maps when process lookup is enabled.
# Binding the host's /proc here would cover the private proc mount and defeat hidepid.
ProtectProc=invisible
ReadOnlyPaths=/proc

ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
PrivateUsers=no
# Mihomo has no use for kernel keyrings; give it its own session keyring instead
# of the host's. The syscall filter denies the keyring operations themselves.
KeyringMode=private

ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
PrivateTmp=yes
# No SysV IPC or POSIX message queues are shared with the host; mihomo uses
# neither (its own Unix sockets are unaffected).
PrivateIPC=yes
RemoveIPC=yes
UMask=0077
RuntimeDirectory=mihomo
RestrictNamespaces=yes

# Device cgroup allowlist: standard pseudo-devices + TUN. Of those, only /dev/null and
# /dev/net/tun are bound into the sandbox (Go uses getrandom(2), not /dev/urandom).
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw

# W^X memory. Test a full connect/DNS/TUN cycle; remove if mihomo fails to start.
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
